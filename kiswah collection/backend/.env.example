# ==========================================
# Kiswah Collection Backend Environment Config
# Copy this file to .env and fill in your own values.
# Get them from: Supabase Dashboard -> Project Settings -> API / Database
# ==========================================

# Supabase project URL (Project Settings -> API -> Project URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# service_role key — server-side only, never expose it in the frontend
SUPABASE_KEY=your-supabase-service-role-key

# Storage bucket for product images (created by supabase_schema.sql)
SUPABASE_STORAGE_BUCKET=product-images

# PostgreSQL connection string (Project Settings -> Database -> Connection string URI)
# Use the Session pooler URI (port 6543) if your pooler uses a transaction pooler.
# Leave empty to fall back to local SQLite at order_logs/kiswah_local.db
DATABASE_URL=postgresql://postgres:your_db_password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# Server Settings
HOST=127.0.0.1
PORT=8000

# Admin login for the /admin panel (username & password can be changed
# from inside the panel — the new password is saved back into this file)
ADMIN_USERNAME=kiswah
ADMIN_PASSWORD=kiswah6767

# Allowed CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
